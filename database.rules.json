{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('host').val() === auth.uid && !newData.exists()))",
        ".validate": "$code.length === 4 && newData.hasChildren(['host'])",
        "host": {
          ".write": "auth != null && newData.val() === auth.uid && (data.val() === auth.uid || !data.exists() || root.child('rooms').child($code).child('players').child(data.val()).child('on').val() !== true)"
        },
        "created": { ".validate": "newData.isNumber()" },
        "state": {
          ".write": "auth != null && newData.parent().child('host').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "cfg": { ".write": "auth != null && newData.parent().child('host').val() === auth.uid" },
        "round": { ".write": "auth != null && newData.parent().child('host').val() === auth.uid" },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 12" }
          }
        },
        "words": {
          "$rn": {
            ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('host').val() === auth.uid",
            "$uid": { ".write": "auth != null && auth.uid === $uid" }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
